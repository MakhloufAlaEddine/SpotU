# =============================================================================
# SpotU — variables d'environnement frontend (Expo)
# =============================================================================
# 1. Copie ce fichier :  cp env.sample .env
# 2. Redémarre Expo après modification (les EXPO_PUBLIC_* sont figées au build Metro).
# =============================================================================

# URL de base de l’API, SANS suffixe /api (le code ajoute /api dans lib/api.ts).
# Simulateur iOS / téléphone / Expo Go → serveur dev Hetzner (HTTP) :
EXPO_PUBLIC_BACKEND_URL=http://178.105.95.184:8080
# Backend Java local sur le Mac :
#   - Simulateur iOS : http://127.0.0.1:8080
#   - Émulateur Android : http://10.0.2.2:8080
#   - Téléphone (même Wi‑Fi) : http://192.168.x.x:8080

# Clé API Google Places (carte / adresses). Optionnel si tu ne testes pas ces écrans.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=

# Push Expo (optionnel). Sur Android, Expo utilise FCM pour le token — sans config EAS/FCM,
# tu verras un avertissement au démarrage (sans impact sur l’API REST). Mets 1 pour ne pas tenter l’enregistrement du token.
# EXPO_PUBLIC_SKIP_PUSH_TOKEN=1
