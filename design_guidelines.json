{
  "design_system": {
    "colors": {
      "background": "#0A0A0A",
      "surface": "#181A1B",
      "surface_highlight": "#202223",
      "primary": "#00BFA5",
      "primary_dim": "rgba(0,191,165,0.1)",
      "text_primary": "#FFFFFF",
      "text_secondary": "#A1A1AA",
      "border": "rgba(255,255,255,0.1)",
      "border_highlight": "rgba(0,191,165,0.3)"
    },
    "typography": {
      "headings": {
        "service_title": {
          "fontSize": 18,
          "fontWeight": "800",
          "color": "#FFFFFF",
          "letterSpacing": -0.2
        },
        "section_title": {
          "fontSize": 14,
          "fontWeight": "700",
          "textTransform": "uppercase",
          "letterSpacing": 1.2,
          "color": "#00BFA5"
        }
      },
      "body": {
        "description": {
          "fontSize": 14,
          "color": "#A1A1AA",
          "lineHeight": 22
        },
        "meta": {
          "fontSize": 12,
          "fontWeight": "600",
          "color": "#E4E4E7"
        }
      },
      "cta": {
        "label": {
          "fontSize": 15,
          "fontWeight": "800",
          "color": "#0A0A0A",
          "textTransform": "uppercase",
          "letterSpacing": 0.5
        }
      }
    },
    "components": {
      "service_card": {
        "container": {
          "backgroundColor": "#181A1B",
          "borderRadius": 24,
          "borderWidth": 1,
          "borderColor": "rgba(0,191,165,0.15)",
          "padding": 20,
          "marginBottom": 16,
          "shadowColor": "#00BFA5",
          "shadowOffset": { "width": 0, "height": 4 },
          "shadowOpacity": 0.08,
          "shadowRadius": 12,
          "elevation": 3
        },
        "price_badge": {
          "backgroundColor": "rgba(0,191,165,0.1)",
          "borderRadius": 12,
          "paddingHorizontal": 12,
          "paddingVertical": 6,
          "borderWidth": 1,
          "borderColor": "rgba(0,191,165,0.2)"
        },
        "meta_pill": {
          "backgroundColor": "#27272A",
          "borderRadius": 8,
          "paddingHorizontal": 10,
          "paddingVertical": 6,
          "flexDirection": "row",
          "alignItems": "center",
          "gap": 6
        },
        "cta_button": {
          "backgroundColor": "#00BFA5",
          "borderRadius": 16,
          "paddingVertical": 14,
          "flexDirection": "row",
          "alignItems": "center",
          "justifyContent": "center",
          "gap": 8
        }
      }
    }
  },
  "instructions_to_main_agent": [
    "Replace the existing 'Services proposés' map rendering with the new premium card design.",
    "Use the color palette strictly: #00BFA5 for primary accents.",
    "Ensure the 'Réserver' button is high-contrast (Black text on Teal background).",
    "Use Ionicons for icons (time-outline, people-outline, arrow-forward).",
    "Maintain the dark mode theme (#0A0A0A background).",
    "Add 'data-testid' attributes to the new 'Réserver' button for testing."
  ]
}