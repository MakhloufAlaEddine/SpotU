    "theme": "Dark Premium",
    "target_file": "/app/frontend/app/user/[id].tsx"
  },
  "design_system": {
    "colors": {
      "background": "#0A0A0A",
      "surface": "#161616",
      "surface_highlight": "#1F1F1F",
      "primary": "#00BFA5",
      "primary_dim": "rgba(0, 191, 165, 0.1)",
      "text_main": "#FFFFFF",
      "text_secondary": "#A1A1AA",
      "text_tertiary": "#71717A",
      "border": "#27272A",
      "success": "#00BFA5",
      "star": "#FFD700"
    },
    "typography": {
      "hero_title": {
        "fontSize": 28,
        "fontWeight": "800",
        "letterSpacing": -0.5,
        "color": "#FFFFFF"
      },
      "section_header": {
        "fontSize": 13,
        "fontWeight": "700",
        "textTransform": "uppercase",
        "letterSpacing": 1.5,
        "color": "#00BFA5"
      }
    }
  },
