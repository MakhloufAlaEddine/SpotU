{
  "project_name": "WINEK - Hyperlocal Sports App",
  "theme": "dark",
  "design_philosophy": {
    "archetype": "THE PERFORMANCE PRO (Digital Athlete)",
    "keywords": ["Kinetic", "Neon", "Precision", "Night Mode"],
    "core_principles": [
      "Dark backgrounds with high-contrast teal accents",
      "Asymmetrical layouts to create visual tension",
      "Card-based UI with deep depth (shadows + borders)",
      "Immersive imagery for locations (TagPoints)"
    ]
  },
  "typography": {
    "font_family": "System (San Francisco / Roboto)",
    "weights": {
      "heading": "800",
      "subheading": "600",
      "body": "400"
    },
    "styles": {
      "hero_title": {
        "fontSize": 32,
        "fontWeight": "800",
        "color": "#FFFFFF",
        "letterSpacing": -0.5
      },
      "section_header": {
        "fontSize": 14,
        "fontWeight": "700",
        "color": "#00BFA5",
        "textTransform": "uppercase",
        "letterSpacing": 1.2,
        "marginBottom": 12
      },
      "card_title": {
        "fontSize": 18,
        "fontWeight": "700",
        "color": "#FFFFFF"
      },
      "body_text": {
        "fontSize": 14,
        "color": "#A1A1AA"
      }
    }
  },
  "colors": {
    "background": "#000000",
    "surface": "#1C1C1E",
    "primary": "#00BFA5",
    "primary_dim": "rgba(0, 191, 165, 0.15)",
    "text_primary": "#FFFFFF",
    "text_secondary": "#A1A1AA",
    "border": "#2C2C2E",
    "overlay": "rgba(0,0,0,0.7)"
  },
  "layout": {
    "spacing": {
      "container_padding": 20,
      "section_gap": 32,
      "item_gap": 16
    },
    "border_radius": {
      "card": 20,
      "button": 12,
      "pill": 100
    }
  },
  "components": {
    "ProfileHeader": {
      "description": "A 'Player Card' style header. Dark teal background with a bottom curve.",
      "style": {
        "backgroundColor": "#0D1F1F",
        "paddingTop": 60,
        "paddingBottom": 40,
        "paddingHorizontal": 24,
        "borderBottomLeftRadius": 32,
        "borderBottomRightRadius": 32,
        "marginBottom": 24
      }
    },
    "ActionGrid": {
      "description": "2-column grid for 'Saved' and 'Events'. Tech-inspired with thin borders.",
      "container_style": {
        "flexDirection": "row",
        "gap": 12,
        "marginBottom": 32,
        "paddingHorizontal": 20
      },
      "item_style": {
        "flex": 1,
        "backgroundColor": "#1C1C1E",
        "padding": 20,
        "borderRadius": 16,
        "borderWidth": 1,
        "borderColor": "rgba(0, 191, 165, 0.3)",
        "alignItems": "center",
        "justifyContent": "center"
      }
    },
    "TagPointCard": {
      "description": "Horizontal scrolling cards. Image background with dark overlay.",
      "container_style": {
        "width": 200,
        "height": 140,
        "marginRight": 12,
        "borderRadius": 16,
        "overflow": "hidden",
        "backgroundColor": "#1C1C1E"
      },
      "overlay_style": {
        "flex": 1,
        "backgroundColor": "rgba(0,0,0,0.5)",
        "padding": 16,
        "justifyContent": "flex-end"
      }
    },
    "SettingsItem": {
      "description": "Clean list items with high contrast.",
      "container_style": {
        "flexDirection": "row",
        "alignItems": "center",
        "justifyContent": "space-between",
        "paddingVertical": 16,
        "borderBottomWidth": 1,
        "borderBottomColor": "#2C2C2E"
      }
    }
  },
  "assets": {
    "avatar_placeholder": "https://images.unsplash.com/photo-1627625591960-0e3e8e23e0e7?auto=format&fit=crop&w=200&q=80",
    "tagpoints": [
      "https://images.unsplash.com/photo-1552984418-b55abf780dd4?auto=format&fit=crop&w=600&q=80",
      "https://images.pexels.com/photos/16955709/pexels-photo-16955709.jpeg?auto=compress&cs=tinysrgb&w=600",
      "https://images.unsplash.com/photo-1552984418-e47d59632489?auto=format&fit=crop&w=600&q=80"
    ]
  },
  "instructions_to_main_agent": [
    "1. Replace the entire styles object with a new StyleSheet based on the guidelines above.",
    "2. Use 'Colors' from '@/constants/Colors' but override specific values (like backgrounds) if needed to match the '#121212' aesthetic.",
    "3. Implement the ProfileHeader as a distinct visual block at the top.",
    "4. Convert the 'Quick Actions' into a 2-column grid using flexbox.",
    "5. Change the 'My TagPoints' section to a horizontal ScrollView with image-based cards.",
    "6. Ensure all interactive elements (TouchableOpacities) have 'activeOpacity={0.8}' for better feel.",
    "7. Add 'data-testid' to all buttons and list items.",
    "8. Use Ionicons: 'bookmark-outline' for Saved, 'calendar-outline' for Events, 'settings-outline', 'log-out-outline'.",
    "9. DO NOT remove any existing functionality or navigation calls.",
    "10. For the TagPoint images, cycle through the provided 'assets.tagpoints' array."
  ]
}