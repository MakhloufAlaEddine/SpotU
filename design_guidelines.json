{
  "design_guidelines": {
    "project_name": "WINEK",
    "persona": "E1_Anti_AI_Designer",
    "theme_mode": "dark",
    "platform": "mobile_web_app",
    "typography": {
      "font_family": "System",
      "headings": {
        "weight": "800",
        "size_xl": 32,
        "size_lg": 24,
        "size_md": 20,
        "letter_spacing": -0.5
      },
      "body": {
        "weight": "400",
        "size_regular": 16,
        "size_small": 14,
        "size_tiny": 12,
        "line_height": 1.5
      }
    },
    "colors": {
      "palette": {
        "background": "#0D1117",
        "surface": "#161B22",
        "surface_highlight": "#21262D",
        "border": "#30363D",
        "primary": "#1DBF73",
        "primary_dim": "rgba(29, 191, 115, 0.15)",
        "accent": "#FF9500",
        "accent_dim": "rgba(255, 149, 0, 0.15)",
        "text_primary": "#F0F6FC",
        "text_secondary": "#8B949E",
        "text_tertiary": "#6E7681",
        "error": "#F85149"
      },
      "usage": {
        "hero_gradient": ["transparent", "rgba(13, 17, 23, 0.9)"],
        "service_border": "#FF9500",
        "tab_bar_bg": "#0D1117"
      }
    },
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "xxl": 48
    },
    "layout_strategy": {
      "concept": "Breathing Room & Hierarchy",
      "header": {
        "style": "Minimal",
        "background": "Blur or Solid #0D1117",
        "elements": ["Location (Left)", "Search (Right)"]
      },
      "sections": [
        {
          "id": "hero",
          "type": "carousel_parallax",
          "height": 280,
          "card_style": "Rounded XL, Full Bleed Image, Gradient Overlay"
        },
        {
          "id": "services",
          "title": "Coachs & Services",
          "style": "Horizontal Scroll",
          "card_aspect": "Landscape Compact",
          "accent_color": "#FF9500"
        },
        {
          "id": "nearby",
          "title": "À proximité",
          "style": "Horizontal List",
          "card_style": "Vertical Card, Image Top, Info Bottom"
        },
        {
          "id": "recent",
          "title": "Derniers ajouts",
          "style": "Vertical List (Feed)",
          "card_style": "Row Layout, Thumbnail Left"
        }
      ]
    },
    "components": {
      "HeroCard": {
        "radius": 24,
        "shadow": "soft_glow_green",
        "typography": "Heading LG White"
      },
      "ServiceCard": {
        "radius": 16,
        "border": "1px solid #FF9500",
        "badge": "Top Right Orange"
      },
      "StandardCard": {
        "radius": 16,
        "background": "#161B22",
        "border": "1px solid #30363D"
      }
    },
    "motion": {
      "library": "react-native-reanimated",
      "type": "Micro-interactions",
      "entrance": "FadeInDown",
      "press": "Scale 0.98"
    }
  },
  "implementation_plan": [
    {
      "step": 1,
      "action": "update_constants",
      "file": "/app/frontend/constants/Colors.ts",
      "details": "Update Colors object to match the 'palette' defined in design_guidelines. Ensure 'primary' is #1DBF73 and 'background' is #0D1117."
    },
    {
      "step": 2,
      "action": "refactor_home",
      "file": "/app/frontend/app/(tabs)/map.tsx",
      "details": "Rewrite the file. Extract sub-components (HeroCard, ServiceCard, etc.) into the same file or separate files if preferred, but keep it clean. Implement the new layout strategy. Use 'react-native-reanimated' for smooth entry animations if possible."
    },
    {
      "step": 3,
      "action": "styling",
      "details": "Apply 'E1' spacing rules. Use gap: 16 or 24. Avoid clutter. Ensure text contrast is high."
    }
  ],
  "universal_guidelines": [
    "Do not use gradients for backgrounds, use solid dark colors #0D1117.",
    "Use 'Inter' or System font with high weight (800) for headings.",
    "Ensure all interactive elements have hitSlop={{top: 10, bottom: 10, left: 10, right: 10}}.",
    "Images must have 'backgroundColor' placeholder while loading.",
    "Use SafeAreaView correctly."
  ]
}