# =============================================================================
# SpotU — variables d'environnement backend (modèle)
# =============================================================================
# 1. Copie ce fichier :  cp env.sample .env
# 2. Remplis les valeurs (ne commite jamais .env).
# Le serveur charge automatiquement backend/.env (voir server.py).
# =============================================================================

# -----------------------------------------------------------------------------
# Étape 1 — PostgreSQL (Supabase)
# -----------------------------------------------------------------------------
# Supabase → Project Settings → Database.
# Utilise l’URI « Session pooler » / mode session, port 5432 (recommandé avec asyncpg).
# Format courant :
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Optionnel : chemin vers un fichier CA (sinon défaut = certs/supabase-ca.crt du repo)
# SSL_CA_CERT_PATH=

# -----------------------------------------------------------------------------
# Étape 2 — JWT (obligatoire au démarrage)
# -----------------------------------------------------------------------------
# Génère une clé :  openssl rand -hex 32
JWT_SECRET=

# -----------------------------------------------------------------------------
# Étape 3 — CORS + URL app (obligatoire pour le front navigateur / Expo web)
# -----------------------------------------------------------------------------
# Liste d’origines séparées par des virgules (sans espaces inutiles).
# Exemples Expo / Metro : http://localhost:8081, http://127.0.0.1:8081
# Ajoute d’autres origines si tu utilises un tunnel (ngrok) ou un autre port.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# URL « canonique » de l’app (fallback CORS si ALLOWED_ORIGINS vide ; utilisée ailleurs dans l’API).
APP_URL=http://localhost:8081

# -----------------------------------------------------------------------------
# Étape 4 — Cloudflare R2 (fichiers / images)
# -----------------------------------------------------------------------------
# Cloudflare Dashboard → R2 → ton bucket → « Manage R2 API Tokens » + endpoint S3.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Exemple : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET_NAME=
# Domaine public servir les objets (custom domain type pub-xxx.r2.dev ou ton domaine)
R2_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Étape 5 — Stripe (optionnel en dev sans paiement)
# -----------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Backend Java (slice 19) : URL de base API Stripe ; laisser vide pour api.stripe.com.
# Ex. proxy de test : https://integrations.emergentagent.com/stripe (sinon détection auto si la clé contient sk_test_emergent).
# STRIPE_API_BASE_OVERRIDE=

# -----------------------------------------------------------------------------
# Optionnel — métier / workers
# -----------------------------------------------------------------------------
# APP_ENV=dev
# BOOKING_EXPIRY_HOURS=48
# EXPIRY_WORKER_INTERVAL_SECS=60
