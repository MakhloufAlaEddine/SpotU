# Copier vers .env : cp .env.example .env
# Ne jamais committer .env (déjà dans .gitignore).

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# JWT (obligatoire — même secret que le backend qui émet les tokens, ex. Python)
JWT_SECRET=

# --- PostgreSQL (Supabase) ---
# URL JDBC complète, ex. :
#   jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# (adapter host/port/db selon ton projet Supabase)
DATABASE_JDBC_URL=
# Identifiants : soit ce trio (lus par application.yml), soit SPRING_DATASOURCE_* ci-dessous.
DATABASE_USER=
DATABASE_PASSWORD=
# Optionnel : surcharge standard Spring Boot (prioritaire sur les placeholders YAML)
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# --- CORS / WebSocket (origines séparées par des virgules, sans espaces superflus) ---
# Inclure l’URL du front (Expo web, admin, etc.). Le mobile natif n’utilise pas CORS comme un navigateur.
APP_CORS_ALLOWED_ORIGINS=
APP_WS_ALLOWED_ORIGINS=

# Cluster WS multi-instance (défaut : désactivé, pas de Redis requis)
APP_WS_CLUSTER_ENABLED=false
APP_WS_CLUSTER_PROVIDER=noop

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Stripe ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_API_BASE_OVERRIDE=

# --- Push Expo (désactivé en dev serveur si pas besoin) ---
# YAML : app.push.expo-enabled ← variable EXPO_PUSH_ENABLED
EXPO_PUSH_ENABLED=false
# EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send

# --- Workers (même processus que l’API) ---
# YAML : expiry.worker.enabled
EXPIRY_WORKER_ENABLED=true
# EXPIRY_WORKER_INTERVAL_SECS=60

# Purge médias marketplace — propriété Java : media.purge.worker.enabled
# → variable d’environnement Spring Boot : MEDIA_PURGE_WORKER_ENABLED
MEDIA_PURGE_WORKER_ENABLED=true
# MEDIA_PURGE_INTERVAL_SECS=3600

# Rappels produits admin — propriété Java : admin.product.reminder.enabled
# → ADMIN_PRODUCT_REMINDER_ENABLED
ADMIN_PRODUCT_REMINDER_ENABLED=true
# ADMIN_PRODUCT_REMINDER_INTERVAL_SECS=600

# --- Redis (optionnel : seulement si APP_WS_CLUSTER_ENABLED=true et provider=redis) ---
# REDIS_HOST=redis
# REDIS_PORT=6379

# --- Fichiers locaux servis sous /api/uploads/** (hors R2) ---
UPLOADS_DIR=/app/uploads
